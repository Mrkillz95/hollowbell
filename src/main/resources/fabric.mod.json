      "net.jj.hollowbell.HollowbellMod"
    ],
    "client": [
      "net.jj.hollowbell.client.HollowbellClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "mixins": [
    "hollowbell.mixins.json",
    {
      "config": "hollowbell.client.mixins.json",
      "environment": "client"
    }
  ]
